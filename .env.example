# Copy to .env and fill in. Never commit the real .env.

# Database (Neon Postgres)
DATABASE_URL=

# Auth
JWT_SECRET=
ADMIN_SECRET_KEY=

# Email (password reset)
RESEND_API_KEY=

# Arkesel SMS + voice fallback (Ghana)
ARKESEL_API_KEY=
ARKESEL_VOICE_API_KEY=
ARKESEL_VOICE_ID=
ARKESEL_VOICE_URL=

# Vapi AI calls
VAPI_PRIVATE_API_KEY=
VAPI_PUBLIC_API_KEY=
# Vapi phone number used for outbound calls. Free Vapi numbers can only call
# US (+1) numbers; import a Twilio/Telnyx number to call Ghana (+233).
VAPI_PHONE_NUMBER_ID=

# Public URL of this app, used for the Vapi webhook (e.g. https://app.example.com)
APP_URL=
# Shared secret Vapi sends in the x-vapi-secret header to /api/vapi/webhook
VAPI_WEBHOOK_SECRET=
# Bearer token for the backup trigger POST /api/reminders/tick
CRON_SECRET=

# Recorded Twi reminder (mp3/wav) played when the patient chooses Twi
TWI_AUDIO_URL=
# Optional recorded Twi/English language menu; a spoken English menu is used if empty
MENU_AUDIO_URL=

# Set to "false" to stop the in-app reminder scheduler (e.g. on a second instance)
REMINDERS_ENABLED=true
# Log reminders/calls without sending anything (testing and demos)
REMINDERS_DRY_RUN=false
# Minutes after the appointment time before it counts as missed (default 15)
REMINDER_MISSED_GRACE_MINUTES=15
# The scheduler is off under `npm run dev` unless this is true (dev usually shares the live database)
REMINDERS_IN_DEV=false
